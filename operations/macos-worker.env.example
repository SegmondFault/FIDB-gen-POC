# Install on the Mac as ~/.config/fidb-factory/macos-worker.env with mode 0600.
# The coordinator origin must be a reviewed HTTPS endpoint reachable from Mac.
FIDB_REMOTE_COORDINATOR=https://replace-with-linux-coordinator.example
FIDB_REMOTE_WORKER_ID=replace-with-macos-worker-id
FIDB_REMOTE_WORKER_TOKEN=replace-with-the-unhashed-worker-token

# Homebrew Ghidra is auto-discovered. Set this for another reviewed install.
# GHIDRA_HEADLESS=/Applications/ghidra/support/analyzeHeadless
# JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-21.jdk/Contents/Home
JAVA_TOOL_OPTIONS="-Xms256m -Xmx8g -XX:ActiveProcessorCount=8"

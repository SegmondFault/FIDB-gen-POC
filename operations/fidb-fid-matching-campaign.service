[Unit]
Description=FIDB native-FID C10 validation methodology
After=local-fs.target

[Service]
Type=oneshot
WorkingDirectory=/home/fidb-operator/Projects/circl/FIDB-POC-unified
ExecStart=/home/fidb-operator/Projects/circl/FIDB-POC-unified/.venv/bin/python -m fidb_poc.cli machine-validation scheduled-matcher --project-root /home/fidb-operator/Projects/circl/FIDB-POC-unified
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=default.target

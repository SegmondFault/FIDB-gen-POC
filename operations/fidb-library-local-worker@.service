[Unit]
Description=FIDB local library queue worker %i
Documentation=file://%h/Projects/circl/FIDB-POC-unified/operations/README.md
PartOf=fidb-library-local-workers.target
ConditionFileIsExecutable=%h/Projects/circl/FIDB-POC-unified/.venv/bin/fidb-poc
ConditionFileNotEmpty=%h/Projects/circl/FIDB-POC-unified/operations/campaigns.toml

[Service]
Type=simple
WorkingDirectory=%h/Projects/circl/FIDB-POC-unified
Environment=PYTHONUNBUFFERED=1
# Required and deliberately installed by the operator.  The repository copy is
# operations/library-local-worker.env.example.
EnvironmentFile=%h/.config/fidb-factory/library-local-worker.env
ExecStart=%h/Projects/circl/FIDB-POC-unified/.venv/bin/fidb-poc queue run --project-root %h/Projects/circl/FIDB-POC-unified --campaign-registry operations/campaigns.toml --worker-id fidb-library-local-%i --pool library-local --use-synced-queue
# The CLI maps deliberate SIGINT/SIGTERM shutdown to conventional shell status.
# Treat those operator stops as clean; build/configuration errors still fail.
SuccessExitStatus=130 143
Restart=on-abnormal
RestartSec=5
TimeoutStopSec=90

# One build adapter uses four make jobs.  Give one worker no more than four CPU
# equivalents and keep an unexpected Ghidra heap expansion inside a hard bound.
CPUQuota=400%
MemoryHigh=6G
MemoryMax=8G
# OpenSSL Android ARM64/O0 imports 1,129 objects and crossed 1,100 observed
# tasks. It failed under the former 1,024-task cap and sealed under the
# measured 2,048-task cap. MemoryMax remains the primary runaway bound.
TasksMax=2048

[Install]
WantedBy=default.target

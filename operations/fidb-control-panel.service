[Unit]
Description=FIDB control panel
Documentation=file://%h/Projects/circl/FIDB-POC-unified/operations/README.md
Wants=fidb-coordinator-api.service
After=fidb-coordinator-api.service
ConditionPathIsDirectory=%h/Projects/circl/FIDB-POC-unified/control-panel/dist
ConditionFileIsExecutable=%h/Projects/circl/FIDB-POC-unified/control-panel/node_modules/.bin/vinext

[Service]
Type=simple
WorkingDirectory=%h/Projects/circl/FIDB-POC-unified/control-panel
Environment=NODE_ENV=production
Environment=FIDB_API_ORIGIN=http://127.0.0.1:8765
Environment=FIDB_CONTROL_PANEL_BIND=127.0.0.1
ExecStart=%h/Projects/circl/FIDB-POC-unified/control-panel/node_modules/.bin/vinext start --hostname ${FIDB_CONTROL_PANEL_BIND} --port 3001
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=default.target

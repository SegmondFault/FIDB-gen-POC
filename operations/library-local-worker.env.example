# Copy this file manually to:
#   ~/.config/fidb-factory/library-local-worker.env
# Keep the installed file owned by the operator and mode 0600.

GHIDRA_HEADLESS=/opt/ghidra/support/analyzeHeadless
JAVA_HOME=/usr/lib/jvm/java-21-openjdk

# Each service also has CPUQuota=400%, MemoryHigh=6G, MemoryMax=8G and
# TasksMax=2048. These JVM settings stop one Ghidra process from discovering all
# 32 host threads or
# selecting its host-wide default maximum heap of roughly 16 GiB.
JAVA_TOOL_OPTIONS="-Xms256m -Xmx4g -XX:ActiveProcessorCount=4"

# Optional typed-notification delivery. Keep unset to retain only the durable
# local JSONL outbox configured by plans/priority-queue.toml.
# FIDB_NOTIFICATION_WEBHOOK_URL=https://notifications.example.invalid/fidb
# FIDB_NOTIFICATION_BEARER_TOKEN=replace-with-a-service-token

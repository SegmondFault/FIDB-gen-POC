# Install as ~/.config/fidb-factory/remote-worker.env with mode 0600 on the
# remote Linux worker. The coordinator origin must use reviewed HTTPS.
FIDB_REMOTE_COORDINATOR=https://replace-with-coordinator-tailnet-name.example
FIDB_REMOTE_WORKER_ID=replace-with-reviewed-worker-id
FIDB_REMOTE_WORKER_TOKEN=replace-with-the-unhashed-worker-token

GHIDRA_HEADLESS=/opt/ghidra/support/analyzeHeadless
JAVA_HOME=/usr/lib/jvm/java-21-openjdk
JAVA_TOOL_OPTIONS="-Xms256m -Xmx4g -XX:ActiveProcessorCount=4"

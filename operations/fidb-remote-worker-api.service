[Unit]
Description=FIDB authenticated remote-worker coordinator API
Documentation=file://%h/Projects/circl/FIDB-POC-unified/operations/README.md
ConditionFileIsExecutable=%h/Projects/circl/FIDB-POC-unified/.venv/bin/fidb-poc
ConditionFileNotEmpty=%h/.config/fidb-factory/remote-workers.json

[Service]
Type=simple
WorkingDirectory=%h/Projects/circl/FIDB-POC-unified
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/Projects/circl/FIDB-POC-unified/.venv/bin/fidb-poc worker-api serve --project-root %h/Projects/circl/FIDB-POC-unified --campaign-registry operations/campaigns.toml --credentials %h/.config/fidb-factory/remote-workers.json --bind 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=-%h/Projects/circl/FIDB-POC-unified/artifacts -%h/Projects/circl/FIDB-POC-unified/var

[Install]
WantedBy=default.target

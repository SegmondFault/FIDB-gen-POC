[Unit]
Description=FIDB authenticated remote-worker coordinator API
Documentation=file:///home/fidb-operator/Projects/circl/FIDB-POC-unified/operations/README.md
ConditionFileIsExecutable=/home/fidb-operator/Projects/circl/FIDB-POC-unified/.venv/bin/fidb-poc
ConditionFileNotEmpty=%h/.config/fidb-factory/remote-workers.json

[Service]
Type=simple
WorkingDirectory=/home/fidb-operator/Projects/circl/FIDB-POC-unified
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/fidb-operator/Projects/circl/FIDB-POC-unified/.venv/bin/fidb-poc worker-api serve --project-root /home/fidb-operator/Projects/circl/FIDB-POC-unified --queue plans/priority-queue.toml --state var/fidb-coordinator/ledger.sqlite3 --credentials %h/.config/fidb-factory/remote-workers.json --bind 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=-/home/fidb-operator/Projects/circl/FIDB-POC-unified/artifacts -/home/fidb-operator/Projects/circl/FIDB-POC-unified/var

[Install]
WantedBy=default.target

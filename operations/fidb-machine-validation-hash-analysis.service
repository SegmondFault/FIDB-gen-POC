[Unit]
Description=FIDB single-hash machine-validation analysis
After=local-fs.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/circl/FIDB-POC-unified
ExecStart=%h/Projects/circl/FIDB-POC-unified/.venv/bin/python -m fidb_poc.cli machine-validation scheduled-hashes --project-root %h/Projects/circl/FIDB-POC-unified
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=default.target
